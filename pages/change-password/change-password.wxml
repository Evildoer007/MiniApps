<!-- 修改密码页面 -->
<view class="pwd-container">

  <view class="pwd-card">

    <!-- 标题 -->
    <view class="pwd-header">
      <text class="pwd-title">修改密码</text>
      <text class="pwd-sub">当前用户：{{targetUser}}</text>
    </view>

    <!-- 表单 -->
    <view class="form-area">

      <!-- 旧密码（非Jason时显示） -->
      <view class="input-group" wx:if="{{!isAdmin}}">
        <text class="input-label">旧密码</text>
        <input class="input-field" type="password" placeholder="请输入旧密码" value="{{oldPassword}}" bindinput="onOldInput" />
      </view>

      <!-- 新密码 -->
      <view class="input-group">
        <text class="input-label">新密码</text>
        <input class="input-field" type="password" placeholder="请输入新密码" value="{{newPassword}}" bindinput="onNewInput" />
      </view>

      <!-- 确认新密码 -->
      <view class="input-group">
        <text class="input-label">确认新密码</text>
        <input class="input-field" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
      </view>

      <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
        确认修改
      </button>

      <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>
    </view>

  </view>

</view>
