<!-- 管理员修改密码页面 -->
<view class="pwd-container">

  <view class="pwd-card">

    <view class="pwd-header">
      <text class="pwd-title">管理员修改密码</text>
    </view>

    <!-- Step 1: 管理员密码验证 -->
    <view class="form-area" wx:if="{{!verified}}">
      <view class="input-group">
        <text class="input-label">请输入管理员密码</text>
        <input class="input-field" type="password" placeholder="管理员密码" value="{{adminPassword}}" bindinput="onAdminInput" />
      </view>
      <button class="save-btn" bindtap="onVerify">验证</button>
      <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>
    </view>

    <!-- Step 2: 选择用户并修改密码 -->
    <view class="form-area" wx:else>
      <view class="input-group">
        <text class="input-label">选择用户</text>
        <picker mode="selector" range="{{userList}}" value="{{userIndex}}" bindchange="onUserChange">
          <view class="picker-display">
            <text>{{userList[userIndex]}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="input-group">
        <text class="input-label">新密码</text>
        <input class="input-field" type="password" placeholder="请输入新密码" value="{{newPassword}}" bindinput="onNewInput" />
      </view>

      <view class="input-group">
        <text class="input-label">确认新密码</text>
        <input class="input-field" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
      </view>

      <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">确认修改</button>
      <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>
    </view>

  </view>

</view>
