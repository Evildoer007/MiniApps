/**
 * 股指期货升贴水 — 页面样式
 * 4 档响应式：compact → normal → wide → tablet
 *
 * 断点 (CSS px):
 *   < 360px  compact    小屏手机
 *   360px+   normal     主流手机（默认）
 *   520px+   wide       大屏 / 横屏 / 小平板 → 双列
 *   768px+   tablet     平板 → 三列
 */

/* ==================== 全局变量 ==================== */
page {
  --bg-primary: #f0f2f5;
  --bg-secondary: #e8eaef;
  --bg-card: #ffffff;
  --text-primary: #1a1d26;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --border: #e5e7eb;
  --accent: #2563eb;
  --red: #e0314b;
  --green: #059669;
  --yellow: #d97706;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.5;
  min-height: 100vh;
}

/* ==================== Container ==================== */
.app-container {
  width: 100%;
  padding: 20rpx 20rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== Header ==================== */
.app-header {
  text-align: center;
  padding: 28rpx 0 6rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.logo-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-logout-top {
  font-size: 20rpx;
  font-weight: 700;
  color: #e0314b;
  background: none;
  border: 1px solid rgba(224, 49, 75, 0.3);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  line-height: 1.4;
}

.btn-admin-top {
  font-size: 20rpx;
  font-weight: 600;
  color: #2563eb;
  background: none;
  border: 1px solid rgba(37, 99, 235, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  line-height: 1.4;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  font-size: 18rpx;
  color: var(--text-muted);
}

.login-user-tag {
  font-size: 20rpx;
  color: #1a1d26;
  font-weight: 600;
  margin-top: 2rpx;
}

.app-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.update-time {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.update-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: var(--green);
}
.update-dot.error { background: var(--red); }

.header-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-top: 12rpx;
}

.header-toolbar .btn {
  margin: 0 auto;
}

.header-toolbar .toggle-label {
  position: absolute;
  right: 0;
}

/* ==================== Tab Bar ==================== */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 18rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 600;
}

/* ==================== Commodity Picker ==================== */
.commodity-selector { margin-bottom: 8rpx; }

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* ==================== Cards Grid ==================== */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cards-grid .card {
  width: 100%;
}

/* ==================== Card ==================== */
.card {
  background: var(--bg-card);
  border-radius: 18rpx;
  padding: 24rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.product-tag {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.product-code {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.product-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.spot-price {
  font-size: 22rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.spot-chg-inline {
  font-weight: 700;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.spot-price text {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 26rpx;
}

/* ==================== Basis Ref Row ==================== */
.basis-ref-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 12rpx;
  background: var(--bg-secondary);
  border-radius: 10rpx;
  margin-bottom: 4rpx;
}

.basis-ref-row.prev {
  margin-bottom: 14rpx;
}

.basis-ref-item {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.basis-ref-val {
  font-weight: 700;
  font-size: 24rpx;
  white-space: nowrap;
}

/* ==================== Section Title ==================== */
.section-title {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 14rpx 0 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  letter-spacing: 0.06em;
}

.section-title-bar {
  width: 4rpx;
  height: 18rpx;
  background: var(--accent);
  border-radius: 2rpx;
  flex-shrink: 0;
}

/* ==================== Table ==================== */
.contract-table { width: 100%; }

.table-hd, .table-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.table-hd {
  border-bottom: 1px solid var(--border);
  font-size: 18rpx;
  color: var(--text-muted);
  padding-bottom: 12rpx;
}

.table-row {
  border-bottom: 1px solid rgba(0,0,0,0.04);
  font-size: 24rpx;
}
.table-row:last-child { border-bottom: none; padding-bottom: 0; }

.table-row.is-front-month {
  background: rgba(37, 99, 235, 0.05);
  border-radius: 6rpx;
  margin: 0 -6rpx;
  padding-left: 6rpx;
  padding-right: 6rpx;
}

/* 列宽基底（小屏） */
.col-contract { width: 64rpx;  flex-shrink: 0; text-align: center; }
.col-price    { width: 110rpx; flex-shrink: 0; text-align: center; }
.col-chg      { flex: 0.8; min-width: 80rpx; text-align: center; font-weight: 600; }
.col-basis    { flex: 1; min-width: 100rpx; text-align: center; font-weight: 600; }
.col-ann      { flex: 1; min-width: 100rpx; text-align: center; font-weight: 600; }
.col-days     { width: 80rpx;  flex-shrink: 0; text-align: center; font-size: 20rpx; color: var(--text-muted); }

/* ==================== 涨跌颜色 ==================== */
.premium  { color: var(--red); }
.discount { color: var(--green); }
.flat     { color: var(--text-secondary); }

/* ==================== Chart ==================== */
.chart-section {
  background: var(--bg-card);
  border-radius: 18rpx;
  padding: 22rpx 14rpx 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.chart-wrapper {
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

.chart-legend { padding: 8rpx 6rpx 2rpx; }

.legend-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4rpx 24rpx;
}

.legend-item {
  font-size: 20rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-color {
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  flex-shrink: 0;
}

/* ==================== Status ==================== */
.card-status {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 4rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

/* ==================== Footer ==================== */
.app-footer { padding: 10rpx 0 60rpx; text-align: center; }

.toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.toggle-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.toggle-switch { transform: scale(.7); }

.footer-credit {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-top: 18rpx;
}

.footer-icp {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* ==================== Loading ==================== */
.loading-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(240, 242, 245, 0.92);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ==================== Toast ==================== */
.toast-container {
  position: fixed;
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
}

.toast {
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  white-space: nowrap;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.toast.error { border-color: var(--red); color: var(--red); }

/* ==================== 历史基差弹出层 ==================== */
.basis-popup-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 300;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.basis-popup-card {
  width: 100%;
  max-width: 680rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.2);
}

.basis-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 12rpx;
}

.basis-popup-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.basis-popup-close {
  width: 48rpx; height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  color: var(--text-muted);
  border-radius: 50%;
  background: var(--bg-secondary);
}

.basis-popup-chart-wrap {
  width: 100%;
  height: 560rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.basis-popup-chart {
  width: 100%;
  height: 100%;
}

.basis-popup-legend {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 28rpx 22rpx;
}

.basis-popup-hint {
  font-size: 20rpx;
  color: var(--text-muted);
}

.basis-popup-range {
  font-size: 20rpx;
  color: var(--text-muted);
}


/* ================================================================ */
/*  断点 1: ≥ 360px  — 主流手机                                     */
/* ================================================================ */
@media (min-width: 360px) {
  .app-container { padding: 24rpx 24rpx 180rpx; gap: 24rpx; }
  .app-header { padding: 32rpx 0 8rpx; }
  .app-title { font-size: 40rpx; }
  .card { padding: 28rpx 24rpx 24rpx; border-radius: 20rpx; }
  .product-code { font-size: 40rpx; }
  .product-name { font-size: 24rpx; }
  .basis-ref-row { padding: 14rpx 16rpx; border-radius: 12rpx; }
  .basis-ref-item { font-size: 22rpx; }
  .basis-ref-val { font-size: 26rpx; }
  .section-title { font-size: 22rpx; padding: 16rpx 0 10rpx; }
  .table-hd { font-size: 20rpx; }
  .table-row { font-size: 25rpx; }
  .col-contract { width: 70rpx; }
  .col-price    { width: 120rpx; }
  .col-chg      { min-width: 90rpx; }
  .col-basis    { min-width: 110rpx; }
  .col-ann      { min-width: 110rpx; }
  .col-days     { width: 90rpx; font-size: 22rpx; }
  .chart-wrapper { height: 520rpx; }
  .chart-section { border-radius: 20rpx; padding: 24rpx 16rpx 16rpx; }
  .btn { font-size: 26rpx; padding: 18rpx 36rpx; }
  .toggle-label { font-size: 24rpx; }
}

/* ================================================================ */
/*  断点 2: ≥ 520px  — 双列卡片                                    */
/* ================================================================ */
@media (min-width: 520px) {
  .app-container {
    max-width: 1080rpx;
    margin: 0 auto;
    padding: 28rpx 24rpx 180rpx;
    gap: 28rpx;
  }

  .cards-grid { gap: 20rpx; }
  .cards-grid .card {
    width: calc(50% - 10rpx);
  }

  /* 双列下收紧 */
  .card { padding: 24rpx 20rpx 20rpx; }
  .card-header { margin-bottom: 16rpx; }
  .product-code { font-size: 36rpx; }
  .product-name { font-size: 22rpx; }
  .spot-price { font-size: 20rpx; }
  .spot-price text { font-size: 24rpx; }
  .basis-ref-row { padding: 12rpx 12rpx; margin-bottom: 3rpx; }
  .basis-ref-item { font-size: 20rpx; }
  .basis-ref-val { font-size: 24rpx; }
  .section-title { font-size: 20rpx; padding: 12rpx 0 6rpx; }
  .table-hd { font-size: 18rpx; }
  .table-row { font-size: 23rpx; }
  .col-contract { width: 56rpx; }
  .col-price    { width: 100rpx; }
  .col-chg      { min-width: 70rpx; }
  .col-basis    { min-width: 90rpx; }
  .col-ann      { min-width: 90rpx; }
  .col-days     { width: 74rpx; font-size: 20rpx; }

  .chart-wrapper { height: 560rpx; }
}

/* ================================================================ */
/*  断点 3: ≥ 768px  — 三列卡片（平板）                             */
/* ================================================================ */
@media (min-width: 768px) {
  .app-container {
    max-width: 1200rpx;
    padding: 32rpx 32rpx 180rpx;
    gap: 32rpx;
  }

  .cards-grid { gap: 24rpx; }
  .cards-grid .card {
    width: calc(33.333% - 16rpx);
  }

  /* IM 卡片跨第一行居中 */
  .cards-grid .card:first-child {
    /* 仍占 1/3，随 flex 自动排列 */
  }

  .card { padding: 28rpx 24rpx 24rpx; }
  .product-code { font-size: 42rpx; }
  .col-contract { width: 60rpx; }
  .col-price    { width: 106rpx; }
  .col-chg      { min-width: 76rpx; }
  .col-basis    { min-width: 96rpx; }
  .col-ann      { min-width: 96rpx; }
  .col-days     { width: 78rpx; }

  .chart-wrapper { height: 600rpx; }

  .app-title { font-size: 44rpx; }
}
