/* 外汇页 */

page {
  background: #f0f2f5;
  font-family: -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;
  font-size: 28rpx;
  color: #1a1d26;
}

.page-scroll {
  width: 100vw;
  height: 100vh;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.bottom-gap { height: 160rpx; }

/* Header */
.app-header { text-align: center; padding: 28rpx 0 16rpx; }
.header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.logo-row { display: flex; align-items: center; gap: 12rpx; }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; font-size: 18rpx; color: #9ca3af; }
.login-user-tag { font-size: 20rpx; color: #1a1d26; font-weight: 600; margin-top: 2rpx; }
.app-title { font-size: 38rpx; font-weight: 700; }
.btn-logout-top { font-size: 20rpx; font-weight: 700; color: #e0314b; background: none; border: 1px solid rgba(224,49,75,.3); border-radius: 8rpx; padding: 4rpx 16rpx; }
.btn-admin-top { font-size: 20rpx; font-weight: 600; color: #2563eb; background: none; border: 1px solid rgba(37,99,235,.4); border-radius: 8rpx; padding: 4rpx 16rpx; }

.update-time { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }

/* 工具栏 */
.header-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-top: 20rpx;
}
.header-toolbar .btn { margin: 0 auto; }
.header-toolbar .toggle-label { position: absolute; right: 0; }
.btn { font-size: 26rpx; font-weight: 600; border-radius: 12rpx; padding: 12rpx 32rpx; line-height: 1.4; }
.btn-primary { background: linear-gradient(135deg,#2563eb,#1d4ed8); color: #fff; border: none; }
.toggle-label { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #6b7280; }
.toggle-switch { transform: scale(.8); }

/* 汇率矩阵 */
.matrix-wrap { margin-top: 20rpx; }
.matrix-hint { font-size: 20rpx; color: #9ca3af; margin-bottom: 12rpx; padding: 0 4rpx; }
.matrix-scroll { width: 100%; }
.matrix {
  display: inline-block;
  min-width: 100%;
  padding: 12rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}
.matrix-row { display: flex; }

/* 左上角 + 行标签列 */
.matrix-corner,
.matrix-row-label {
  width: 88rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f8;
}
.matrix-row-label { flex-direction: column; }

/* 币种代码 + 国旗 */
.hd-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7280;
  line-height: 1.2;
}

/* 单元格（表头与数据共用固定宽度，保证对齐） */
.matrix-col-head {
  width: 108rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 表头行 */
.matrix-head .matrix-col-head {
  flex-direction: column;
  background: #eef0f3;
}

/* 数据行单元格 */
.matrix-row:not(.matrix-head) .matrix-col-head {
  background: #fff;
  border-right: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell-empty { width: 100%; height: 100%; background: #f5f6f8; }
.cell-value {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #1a1d26;
}
.cell-value:active { background: #eef0f3; }

/* 汇率计算器 */
.calc-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}
.calc-title { font-size: 28rpx; font-weight: 700; margin-bottom: 8rpx; }
.calc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}
.calc-label { font-size: 26rpx; color: #6b7280; flex-shrink: 0; }
.calc-picker { flex: 1; margin-left: 24rpx; }
.calc-picker-value {
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  padding: 10rpx 16rpx;
  background: #f5f6f8;
  border-radius: 10rpx;
}
.calc-input {
  flex: 1;
  margin-left: 24rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 10rpx 16rpx;
  background: #f5f6f8;
  border-radius: 10rpx;
  min-height: 40rpx;
}
.calc-divider { height: 1rpx; background: #f0f0f0; margin: 8rpx 0; }
.calc-result { font-size: 34rpx; font-weight: 700; color: #2563eb; }
.calc-rate { font-size: 24rpx; color: #6b7280; text-align: right; margin-top: 8rpx; }

/* Footer */
.app-footer { padding: 10rpx 0 60rpx; text-align: center; }
.footer-credit { font-size: 18rpx; color: #9ca3af; }
.footer-icp { font-size: 18rpx; color: #9ca3af; margin-top: 4rpx; }

/* Toast */
.toast-container {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
}
.toast {
  background: rgba(26,29,38,.9);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

/* 涨跌颜色 */
.premium  { color: #e0314b; }
.discount { color: #059669; }
.flat     { color: #1a1d26; }

/* 行情详情浮窗 */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.popup-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,.2);
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.popup-title { display: flex; flex-direction: column; }
.popup-pair { font-size: 34rpx; font-weight: 700; }
.popup-code { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.popup-close { font-size: 32rpx; color: #9ca3af; padding: 4rpx 8rpx; line-height: 1; }
.popup-latest { font-size: 56rpx; font-weight: 700; text-align: center; margin-top: 24rpx; }
.popup-change-row { display: flex; justify-content: center; gap: 16rpx; font-size: 26rpx; margin-top: 8rpx; }
.popup-desc { text-align: center; font-size: 24rpx; color: #6b7280; margin-top: 16rpx; }
.popup-grid { display: flex; flex-wrap: wrap; margin-top: 24rpx; border-top: 1rpx solid #f0f0f0; }
.popup-grid-item {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.popup-grid-k { font-size: 22rpx; color: #9ca3af; }
.popup-grid-v { font-size: 28rpx; font-weight: 600; }
