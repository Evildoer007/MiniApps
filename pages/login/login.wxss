/* 登录页面 — 明亮主题 */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e8edf5 0%, #f5f6f8 50%, #e8edf5 100%);
}

.login-card {
  width: 100%;
  max-width: 640rpx;
}

/* ========== Brand ========== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.brand-sub {
  font-size: 30rpx;
  color: #6b7280;
  margin-top: 12rpx;
}

/* ========== Form ========== */
.form-area {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 96rpx;
  background: #f5f6f8;
  border: 1px solid #e5e7eb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1a1d26;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #9ca3af;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 44rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border: none;
  border-radius: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.15em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn[disabled] {
  opacity: 0.5;
}

.error-msg {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #e0314b;
  margin-top: 20rpx;
}

.extra-actions {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.link-change-pwd {
  font-size: 26rpx;
  color: #6b7280;
  text-decoration: underline;
}

/* ========== Footer ========== */
.login-footer {
  position: fixed;
  bottom: 48rpx;
  font-size: 20rpx;
  color: #9ca3af;
  text-align: center;
}

.footer-icp {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
