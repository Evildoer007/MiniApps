/**
 * 股指期货升贴水 — 全局样式
 * 明亮金融主题
 */

/* ---------- Reset & Base ---------- */
page {
  --bg-primary: #f5f6f8;
  --bg-secondary: #eef0f3;
  --bg-card: #ffffff;
  --bg-card-hover: #f0f2f5;
  --text-primary: #1a1d26;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --border: #e5e7eb;
  --accent: #2563eb;
  --accent-dim: #93b4f5;
  --red: #e0314b;
  --green: #059669;
  --yellow: #d97706;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --max-width: 520px;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
               'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.5;
  min-height: 100vh;
  -webkit-tap-highlight-color: transparent;
}
