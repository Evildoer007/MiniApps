.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1px solid #e5e7eb;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.12);
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 6rpx;
  color: #9ca3af;
}

.bar-item.active {
  color: #2563eb;
}

.bar-icon {
  font-size: 36rpx;
}

.bar-label {
  font-size: 20rpx;
  margin-top: 2rpx;
  font-weight: 500;
}

.bar-item.active .bar-label {
  font-weight: 700;
}

/* 晨报更新气泡提示 */
.morning-bubble {
  position: fixed;
  bottom: 130rpx;
  width: 220rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: #ff4d4f;
  border-radius: 20rpx;
  z-index: 1000;
}
