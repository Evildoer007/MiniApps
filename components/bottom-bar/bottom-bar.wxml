<!-- 底部导航栏 — 使用 cover-view 覆盖原生 Canvas -->
<block>
  <cover-view class="morning-bubble" wx:if="{{showBubble}}" style="left: {{bubbleLeft}}px;">更新啦～</cover-view>
  <cover-view class="bottom-bar">
    <cover-view class="bar-item {{active === item.tab ? 'active' : ''}}"
                wx:for="{{tabs}}" wx:key="tab"
                data-tab="{{item.tab}}" bindtap="onTap">
      <cover-view class="bar-icon">{{item.icon}}</cover-view>
    </cover-view>
  </cover-view>
</block>
